# ---------------------------------------------------------------- copy me
# Copy this file to backend/.env and fill in the secret. Everything else has a
# working default for a single laptop running Ollama.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

ENVIRONMENT=development

# Where the app keeps its own data. Created automatically on first run.
DATABASE_URL=sqlite:///./data/gradewise.db
PRIVATE_DIR=./data/uploads

# ---------------------------------------------------------------- local AI
# `ollama serve` must be running before the backend starts marking.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=900
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PREDICT=2600

# Three small models share the work (about 5 GB, fine on 16 GB of RAM):
# glm-ocr reads the scan, llama3.2:3b marks the paper. For sharper marking set
# OLLAMA_MODEL=llama3.1:8b (about 4.7 GB more).
OLLAMA_OCR_MODEL=glm-ocr:latest
OLLAMA_MODEL=llama3.2:3b

# Used by the dense retriever (Chroma). Nothing leaves the machine.
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------- retrieval
# dense = embeddings + Chroma, lexical = keyword scorer only.
# Dense falls back to lexical on its own if Chroma or the model is missing.
RETRIEVAL_MODE=dense
RETRIEVAL_K=8
RETRIEVAL_CHARS=6000
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=ol_english_rubric

# ---------------------------------------------------------------- uploads
MAX_UPLOAD_MB=200
MAX_FILES=6
MAX_PAGES=40

# Page reading: 150 DPI greyscale is legible for handwriting and small enough
# for the OCR model to hold in context.
OCR_DPI=150
OCR_QUALITY=72
OCR_MIN_CHARS=60

# Characters of prompt sent to the model. Keeps a run inside an 8k context.
PROMPT_CHARS=12000

# Only these origins may call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173